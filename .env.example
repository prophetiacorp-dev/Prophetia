NODE_ENV=production
PORT=4242
SITE_URL=https://prophetia.es

# Mantener en false hasta el lanzamiento real.
SALES_ENABLED=false

# Debe apuntar a un volumen persistente del backend.
DATA_DIR=/var/data/prophetia

STRIPE_SECRET_KEY=sk_live_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

RESEND_API_KEY=re_REPLACE_ME
ORDER_FROM_EMAIL=Prophetia <orders@prophetia.es>
# Aquí llegan los avisos con demanda acumulada por producto, color y talla.
ORDER_INTERNAL_EMAIL=clientservices@prophetia.com

# Ruta privada al service account; nunca guardar el JSON dentro del repositorio.
FIREBASE_ADMIN_CREDENTIALS=/etc/secrets/firebase-admin.json
