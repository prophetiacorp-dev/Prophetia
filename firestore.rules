rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn() && request.auth.uid in [
        'Z9HEs3YmEgePYdmsD6UaY9idv0A2'
      ];
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /site/home {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /users/{uid} {
      allow read, create, update: if isOwner(uid);
      allow delete: if false;

      match /addresses/{addressId} {
        allow read, create, update, delete: if isOwner(uid);
      }

      match /reservations/{reservationId} {
        allow read, create, update, delete: if isOwner(uid);
      }

      match /private/{documentId} {
        allow read, create, update, delete: if isOwner(uid);
      }
    }

    match /stockWaitlist/{sku}/entries/{emailHash} {
      allow read, write: if false;
    }

    match /stockDemandProducts/{productId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
